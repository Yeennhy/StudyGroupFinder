<?xml version="1.0" encoding="utf-8"?>
<!--
  The main navigation graph for the application.
-->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <!-- ============================ auth ============================ -->

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.studyfinder.app.ui.auth.SplashFragment"
        android:label="@string/app_name"
        tools:layout="@layout/fragment_splash">

        <action
            android:id="@+id/action_splashFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_splashFragment_to_communitySelectionFragment"
            app:destination="@id/communitySelectionFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_splashFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.studyfinder.app.ui.auth.LoginFragment"
        android:label="@string/title_login"
        tools:layout="@layout/fragment_login">

        <action
            android:id="@+id/action_loginFragment_to_signupFragment"
            app:destination="@id/signupFragment" />
        <action
            android:id="@+id/action_loginFragment_to_forgotPasswordFragment"
            app:destination="@id/forgotPasswordFragment" />
        <!-- Signed in but no community yet. -->
        <action
            android:id="@+id/action_loginFragment_to_communitySelectionFragment"
            app:destination="@id/communitySelectionFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
        <!-- Returning user with a community already set. -->
        <action
            android:id="@+id/action_loginFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/signupFragment"
        android:name="com.studyfinder.app.ui.auth.SignupFragment"
        android:label="@string/title_signup"
        tools:layout="@layout/fragment_signup">

        <action
            android:id="@+id/action_signupFragment_to_communitySelectionFragment"
            app:destination="@id/communitySelectionFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_signupFragment_to_successFragment"
            app:destination="@id/successFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/forgotPasswordFragment"
        android:name="com.studyfinder.app.ui.auth.ForgotPasswordFragment"
        android:label="@string/title_forgot_password"
        tools:layout="@layout/fragment_forgot_password">
        <action
            android:id="@+id/action_forgotPasswordFragment_to_successFragment"
            app:destination="@id/successFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/successFragment"
        android:name="com.studyfinder.app.ui.auth.SuccessFragment"
        android:label="Success"
        tools:layout="@layout/fragment_success">
        <argument
            android:name="message"
            app:argType="string" />
        <argument
            android:name="subtitle"
            app:argType="string" />
        <argument
            android:name="buttonText"
            app:argType="string" />
        <argument
            android:name="isSignupSuccess"
            android:defaultValue="false"
            app:argType="boolean" />
        <action
            android:id="@+id/action_successFragment_to_communitySelectionFragment"
            app:destination="@id/communitySelectionFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_successFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_successFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_successFragment_to_mySessionsFragment"
            app:destination="@id/mySessionsFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- ====================== community selection ==================== -->

    <fragment
        android:id="@+id/communitySelectionFragment"
        android:name="com.studyfinder.app.ui.community.CommunitySelectionFragment"
        android:label="@string/title_community_selection"
        tools:layout="@layout/fragment_community_selection">

        <!-- false = first login, continues to Home. true = "edit community"
             from Profile. -->
        <argument
            android:name="isEditMode"
            android:defaultValue="false"
            app:argType="boolean" />

        <action
            android:id="@+id/action_communitySelectionFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />

        <action
            android:id="@+id/action_communitySelectionFragment_to_profileFragment"
            app:destination="@id/profileFragment" />
    </fragment>

    <!-- ============================= home =========================== -->

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.studyfinder.app.ui.home.HomeFragment"
        android:label="@string/title_home"
        tools:layout="@layout/fragment_home">

        <action
            android:id="@+id/action_homeFragment_to_sessionDetailFragment"
            app:destination="@id/sessionDetailFragment" />
        <!-- The "+ button from Home". -->
        <action
            android:id="@+id/action_homeFragment_to_createSessionFragment"
            app:destination="@id/createSessionFragment" />
        <action
            android:id="@+id/action_homeFragment_to_historyFragment"
            app:destination="@id/historyFragment" />
    </fragment>

    <!-- ======================== session detail ====================== -->

    <fragment
        android:id="@+id/sessionDetailFragment"
        android:name="com.studyfinder.app.ui.sessiondetail.SessionDetailFragment"
        android:label="@string/title_session_detail"
        tools:layout="@layout/fragment_session_detail">

        <argument
            android:name="sessionId"
            app:argType="string" />
        <!-- PAST view mode, reached from History — every action button is suppressed. -->
        <argument
            android:name="viewMode"
            android:defaultValue="LIVE"
            app:argType="com.studyfinder.app.model.SessionViewMode" />

        <action
            android:id="@+id/action_sessionDetailFragment_to_sessionManageFragment"
            app:destination="@id/sessionManageFragment" />
        <action
            android:id="@+id/action_sessionDetailFragment_to_inviteByStudentIdFragment"
            app:destination="@id/inviteByStudentIdFragment" />
        <action
            android:id="@+id/action_sessionDetailFragment_to_profileFragment"
            app:destination="@id/profileFragment" />
        <!-- "Continue from last time" lives inside past-session detail. -->
        <action
            android:id="@+id/action_sessionDetailFragment_to_createSessionFragment"
            app:destination="@id/createSessionFragment" />
        <action
            android:id="@+id/action_sessionDetailFragment_to_historyFragment"
            app:destination="@id/historyFragment" />
    </fragment>

    <!-- ======================== create session ====================== -->

    <fragment
        android:id="@+id/createSessionFragment"
        android:name="com.studyfinder.app.ui.sessioncreate.CreateSessionFragment"
        android:label="@string/title_create_session"
        tools:layout="@layout/fragment_create_session">

        <!-- Non-null when arriving via "continue from last time". -->
        <argument
            android:name="prefillFromSessionId"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />

        <!-- Replaces itself in the back stack, so Back from the new session
             returns to Home rather than to a filled-in form. -->
        <action
            android:id="@+id/action_createSessionFragment_to_sessionDetailFragment"
            app:destination="@id/sessionDetailFragment"
            app:popUpTo="@id/createSessionFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_createSessionFragment_to_successFragment"
            app:destination="@id/successFragment"
            app:popUpTo="@id/createSessionFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- ======================= session management =================== -->

    <fragment
        android:id="@+id/sessionManageFragment"
        android:name="com.studyfinder.app.ui.sessionmanage.SessionManageFragment"
        android:label="@string/title_session_manage"
        tools:layout="@layout/fragment_session_manage">

        <argument
            android:name="sessionId"
            app:argType="string" />

        <action
            android:id="@+id/action_sessionManageFragment_to_inviteByStudentIdFragment"
            app:destination="@id/inviteByStudentIdFragment" />
        <action
            android:id="@+id/action_sessionManageFragment_to_profileFragment"
            app:destination="@id/profileFragment" />
    </fragment>

    <fragment
        android:id="@+id/inviteByStudentIdFragment"
        android:name="com.studyfinder.app.ui.sessionmanage.InviteByStudentIdFragment"
        android:label="@string/title_invite_by_student_id"
        tools:layout="@layout/fragment_invite_by_student_id">

        <argument
            android:name="sessionId"
            app:argType="string" />

        <action
            android:id="@+id/action_inviteByStudentIdFragment_to_successFragment"
            app:destination="@id/successFragment" />
    </fragment>

    <!-- ==================== my sessions & history =================== -->

    <fragment
        android:id="@+id/mySessionsFragment"
        android:name="com.studyfinder.app.ui.mysessions.MySessionsFragment"
        android:label="@string/title_my_sessions"
        tools:layout="@layout/fragment_my_sessions">

        <action
            android:id="@+id/action_mySessionsFragment_to_sessionDetailFragment"
            app:destination="@id/sessionDetailFragment" />
        <action
            android:id="@+id/action_mySessionsFragment_to_sessionManageFragment"
            app:destination="@id/sessionManageFragment" />
        <action
            android:id="@+id/action_mySessionsFragment_to_historyFragment"
            app:destination="@id/historyFragment" />
    </fragment>

    <fragment
        android:id="@+id/historyFragment"
        android:name="com.studyfinder.app.ui.history.HistoryFragment"
        android:label="@string/title_history"
        tools:layout="@layout/fragment_history">

        <!-- Always opens detail in PAST mode. -->
        <action
            android:id="@+id/action_historyFragment_to_sessionDetailFragment"
            app:destination="@id/sessionDetailFragment" />
        <action
            android:id="@+id/action_historyFragment_to_successFragment"
            app:destination="@id/successFragment" />
    </fragment>

    <!-- ============================ inbox =========================== -->

    <fragment
        android:id="@+id/inboxFragment"
        android:name="com.studyfinder.app.ui.inbox.InboxFragment"
        android:label="@string/title_inbox"
        tools:layout="@layout/fragment_inbox">

        <!-- The "Details" button on an invite row. -->
        <action
            android:id="@+id/action_inboxFragment_to_sessionDetailFragment"
            app:destination="@id/sessionDetailFragment" />
        <!-- join_request rows are host-facing. -->
        <action
            android:id="@+id/action_inboxFragment_to_sessionManageFragment"
            app:destination="@id/sessionManageFragment" />
        <action
            android:id="@+id/action_inboxFragment_to_historyFragment"
            app:destination="@id/historyFragment" />
    </fragment>

    <!-- ============================ profile ========================= -->

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.studyfinder.app.ui.profile.ProfileFragment"
        android:label="@string/title_profile"
        tools:layout="@layout/fragment_profile">

        <!-- null = self view (editable). Non-null = read-only view of another
             user, reached from a member list. -->
        <argument
            android:name="uid"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />

        <!-- Community edit in profile. -->
        <action
            android:id="@+id/action_profileFragment_to_communitySelectionFragment"
            app:destination="@id/communitySelectionFragment" />
        <!-- Sign out clears the cache and drops the entire back stack. -->
        <action
            android:id="@+id/action_profileFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

</navigation>
