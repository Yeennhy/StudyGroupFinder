<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="true"
    android:clipToPadding="true"
    android:background="@drawable/bg_dotted_paper">

    <!-- Header bar (Top) -->
    <include
        android:id="@+id/appHeader"
        layout="@layout/layout_app_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Navbar (Bottom) -->
    <include
        android:id="@+id/navBar"
        layout="@layout/fragment_navbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Left Pane: Search & Filters (Scrollable) -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollFilters"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="20dp"
        android:paddingBottom="20dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/appHeader"
        app:layout_constraintBottom_toTopOf="@id/navBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/guideline"
        app:layout_constraintWidth_percent="0.35">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="10dp">

            <!-- Search bar -->
            <EditText
                android:id="@+id/etSearch"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_whitebox_dropsd"
                android:hint="Search name, ID..."
                android:textColor="@color/graphite"
                android:drawableStart="@drawable/ic_search"
                android:drawablePadding="12dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:gravity="center_vertical"
                android:textSize="14sp"
                android:singleLine="true"
                android:fontFamily="@font/bricolagegrotesque_regular" />

            <!-- Group Filter Section -->
            <TextView
                android:id="@+id/tvHeaderCategories"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Categories"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/graphite"
                android:fontFamily="@font/bricolagegrotesque_bold" />

            <HorizontalScrollView
                android:id="@+id/scrollCategoryFilters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView android:id="@+id/chipAllSessions" style="@style/HomeFilterPillSelected" android:text="All" />
                    <TextView android:id="@+id/chipMidterm" style="@style/HomeFilterPill" android:layout_marginStart="8dp" android:text="Midterm" />
                    <TextView android:id="@+id/chipFinal" style="@style/HomeFilterPill" android:layout_marginStart="8dp" android:text="Final" />
                    <TextView android:id="@+id/chipReview" style="@style/HomeFilterPill" android:layout_marginStart="8dp" android:text="Review" />

                </LinearLayout>

            </HorizontalScrollView>

            <TextView
                android:id="@+id/tvHeaderTypes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Types"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/graphite"
                android:fontFamily="@font/bricolagegrotesque_bold" />

            <HorizontalScrollView
                android:id="@+id/scrollCourseTypeFilters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView android:id="@+id/chipTypeAll" style="@style/HomeFilterPillSelected" android:text="All" />
                    <TextView android:id="@+id/chipTypePhysics" style="@style/HomeFilterPill" android:text="Physics" />
                    <TextView android:id="@+id/chipTypeCalculus" style="@style/HomeFilterPill" android:text="Calculus" />
                    <TextView android:id="@+id/chipTypeDsa" style="@style/HomeFilterPill" android:text="DSA" />
                    <TextView android:id="@+id/chipTypeProgramming" style="@style/HomeFilterPill" android:text="Programming" />
                    <TextView android:id="@+id/chipTypeEnglish" style="@style/HomeFilterPill" android:text="English" />
                    <TextView android:id="@+id/chipTypeArts" style="@style/HomeFilterPill" android:text="Arts" />
                    <TextView android:id="@+id/chipTypeSocial" style="@style/HomeFilterPill" android:text="Social" />
                    <TextView android:id="@+id/chipTypeOther" style="@style/HomeFilterPill" android:text="Other" />

                </LinearLayout>

            </HorizontalScrollView>

            <TextView
                android:id="@+id/tvHeaderExpectation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Expectation Level"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/graphite"
                android:fontFamily="@font/bricolagegrotesque_bold" />

            <HorizontalScrollView
                android:id="@+id/scrollExpectationFilters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView android:id="@+id/chipExpAll" style="@style/HomeFilterPillSelected" android:text="All" />
                    <TextView android:id="@+id/chipExpPass" style="@style/HomeFilterPill" android:layout_marginStart="8dp" android:text="Pass" />
                    <TextView android:id="@+id/chipExpCasual" style="@style/HomeFilterPill" android:layout_marginStart="8dp" android:text="Casual" />
                    <TextView android:id="@+id/chipExpGrind" style="@style/HomeFilterPill" android:layout_marginStart="8dp" android:text="Grind" />

                </LinearLayout>

            </HorizontalScrollView>

            <TextView
                android:id="@+id/tvHeaderOptions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Options"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/graphite"
                android:fontFamily="@font/bricolagegrotesque_bold" />

            <LinearLayout
                android:id="@+id/rowOptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnExpandFilters"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_toggle_unselected_offset"
                    android:src="@drawable/ic_chevron_right"
                    android:scaleType="centerInside"
                    android:rotation="90"
                    app:tint="@color/graphite" />

                <TextView
                    android:id="@+id/tvSort"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_toggle_unselected_offset"
                    android:text="Sort"
                    android:textColor="@color/graphite"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:drawableEnd="@drawable/ic_timer"
                    android:drawablePadding="4dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="11dp"
                    android:fontFamily="@font/pjsans_bold" />

            </LinearLayout>

            <TextView
                android:id="@+id/toggleConflicting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_toggle_unselected_offset"
                android:text="Hide Conflicts"
                android:textColor="@color/graphite"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingTop="8dp"
                android:paddingBottom="11dp"
                android:fontFamily="@font/pjsans_bold" />

            <!-- Hidden toggles for animation consistency -->
            <TextView android:id="@+id/toggleGrind" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <TextView android:id="@+id/toggleCasual" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.35" />

    <!-- Right Pane: Session List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSessions"
        android:layoutAnimation="@anim/layout_animation_slide_up"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingTop="20dp"
        android:paddingStart="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp"
        android:clipToPadding="false"
        app:spanCount="2"
        app:layout_constraintTop_toBottomOf="@id/appHeader"
        app:layout_constraintBottom_toTopOf="@id/navBar"
        app:layout_constraintStart_toEndOf="@id/guideline"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/item_home_session" />

    <!-- UI States (Over rvSessions) -->
    <include
        android:id="@+id/stateLoading"
        layout="@layout/layout_state_loading"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/rvSessions"
        app:layout_constraintBottom_toBottomOf="@id/rvSessions"
        app:layout_constraintStart_toStartOf="@id/rvSessions"
        app:layout_constraintEnd_toEndOf="@id/rvSessions" />

    <include
        android:id="@+id/stateEmpty"
        layout="@layout/layout_state_empty"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/rvSessions"
        app:layout_constraintBottom_toBottomOf="@id/rvSessions"
        app:layout_constraintStart_toStartOf="@id/rvSessions"
        app:layout_constraintEnd_toEndOf="@id/rvSessions" />

    <include
        android:id="@+id/stateError"
        layout="@layout/layout_state_error"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/rvSessions"
        app:layout_constraintBottom_toBottomOf="@id/rvSessions"
        app:layout_constraintStart_toStartOf="@id/rvSessions"
        app:layout_constraintEnd_toEndOf="@id/rvSessions" />

    <include
        android:id="@+id/stateOfflineBanner"
        layout="@layout/layout_state_offline_banner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/rvSessions"
        app:layout_constraintStart_toStartOf="@id/rvSessions"
        app:layout_constraintEnd_toEndOf="@id/rvSessions" />

    <FrameLayout
        android:id="@+id/fabAdd"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_fab"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:paddingEnd="3dp"
        android:paddingBottom="4dp"
        android:elevation="8dp"
        app:layout_constraintBottom_toTopOf="@id/navBar"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="+"
            android:textColor="@color/graphite"
            android:textSize="32sp"
            android:textStyle="bold"
            android:includeFontPadding="false" />

    </FrameLayout>

    <!-- To maintain IDs for scrollToggleFilters etc. -->
    <View android:id="@+id/scrollToggleFilters" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>