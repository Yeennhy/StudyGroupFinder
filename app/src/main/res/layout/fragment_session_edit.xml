<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_whitebox_dropsd"
    android:clipToPadding="false"
    android:clipChildren="false"
    android:paddingStart="4dp"
    android:paddingTop="4dp"
    android:paddingEnd="6dp"
    android:paddingBottom="10dp"
    >

    <!-- ===== Header: "Edit Details" + close (X) button, mint/teal like mockup ===== -->
    <LinearLayout
        android:id="@+id/dialogHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_card_header_teal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Edit Details"
            android:textStyle="bold"
            android:textSize="24sp"
            android:textColor="@color/graphite"
            android:fontFamily="@font/bricolagegrotesque_bold" />

        <com.google.android.material.card.MaterialCardView
            android:theme="@style/Theme.MaterialComponents.Light"
            android:id="@+id/kick_btn_container"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:strokeWidth="2dp"
            app:strokeColor="@color/graphite"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:clipChildren="true"
            >
            <ImageButton

                android:id="@+id/kick_btn"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_x"
                android:scaleType="fitCenter"
                android:padding="12dp"
                app:tint="@color/graphite"
                android:clickable="false"
                android:focusable="false"
                android:background="@color/white"
                android:backgroundTint="@color/white" />
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <View
        android:id="@+id/topDivider"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:background="@color/graphite"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dialogHeader"
        />
    <!-- ===== Scrollable form body ===== -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollDialogContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:layout_marginTop="2dp"
        app:layout_constraintTop_toBottomOf="@id/dialogHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/dialogFooter"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="20dp"
            android:background="@color/theme_cream">

            <!-- Session Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Session Title"
                android:textStyle="bold"
                android:textSize="12sp"
                android:textColor="@color/graphite"
                android:fontFamily="@font/bricolagegrotesque_bold" />

            <EditText
                android:id="@+id/etDialogTitle"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_field"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:gravity="center_vertical"
                android:singleLine="true"
                android:textSize="15sp"
                android:fontFamily="@font/pjsans_medium" />

            <!-- Description & Goals -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Description"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="@color/graphite"
                android:fontFamily="@font/bricolagegrotesque_bold" />

            <EditText
                android:id="@+id/etDialogDescription"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_field"
                android:padding="12dp"
                android:gravity="top|start"
                android:inputType="textMultiLine"
                android:textSize="14sp"
                android:fontFamily="@font/pjsans_medium" />

            <!-- Description & Goals -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/bricolagegrotesque_bold"
                android:text="Goals"
                android:textColor="@color/graphite"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:visibility="gone"
                android:id="@+id/etDialogGoals"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_field"
                android:padding="12dp"
                android:gravity="top|start"
                android:inputType="textMultiLine"
                android:textSize="14sp"
                android:fontFamily="@font/pjsans_medium" />

            <!-- Preparing For / Expectation Level -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp">

                <TextView
                    android:id="@+id/lblDialogPreparingFor"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Preparing for"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:textColor="@color/graphite"
                    android:fontFamily="@font/bricolagegrotesque_bold"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/lblDialogExpectation"
                    app:layout_constraintHorizontal_chainStyle="spread_inside" />

                <TextView
                    android:id="@+id/lblDialogExpectation"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Expectation Level"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:textColor="@color/graphite"
                    android:fontFamily="@font/bricolagegrotesque_bold"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toEndOf="@id/lblDialogPreparingFor"
                    app:layout_constraintEnd_toEndOf="parent" />

                <Spinner
                    android:id="@+id/spinnerDialogPreparingFor"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_input_field"
                    android:padding="8dp"
                    app:layout_constraintTop_toBottomOf="@id/lblDialogPreparingFor"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/spinnerDialogExpectation"
                    app:layout_constraintWidth_percent="0.47" />

                <Spinner
                    android:id="@+id/spinnerDialogExpectation"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_input_field"
                    android:padding="8dp"
                    app:layout_constraintTop_toBottomOf="@id/lblDialogExpectation"
                    app:layout_constraintStart_toEndOf="@id/spinnerDialogPreparingFor"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintWidth_percent="0.47" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Tags -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Tags"
                android:textStyle="bold"
                android:textSize="12sp"
                android:textColor="@color/graphite"
                android:fontFamily="@font/bricolagegrotesque_bold" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/tagContainerDialog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="8dp"
                app:singleLine="false">

                <com.google.android.material.chip.Chip
                    android:id="@+id/tagDialogCs162"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CS162"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:textColor="@color/graphite"
                    android:fontFamily="@font/pjsans_bold"
                    app:chipBackgroundColor="@color/ginkgo_yellow"
                    app:chipStrokeColor="@color/graphite"
                    app:chipStrokeWidth="2.5dp"
                    app:chipCornerRadius="20dp"
                    app:closeIconEnabled="true"
                    app:closeIconTint="@color/graphite"
                    app:closeIconSize="16dp"
                    app:chipMinHeight="36dp"
                    app:ensureMinTouchTargetSize="false" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/tagDialogDijkstra"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dijkstra"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:textColor="@color/graphite"
                    android:fontFamily="@font/pjsans_bold"
                    app:chipBackgroundColor="@color/light_blue"
                    app:chipStrokeColor="@color/graphite"
                    app:chipStrokeWidth="2.5dp"
                    app:chipCornerRadius="20dp"
                    app:closeIconEnabled="true"
                    app:closeIconTint="@color/graphite"
                    app:closeIconSize="16dp"
                    app:chipMinHeight="36dp"
                    app:ensureMinTouchTargetSize="false" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/btnAddTagDialog"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+ Add Tag"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:textColor="@color/graphite"
                    android:fontFamily="@font/bricolagegrotesque_bold"
                    app:chipBackgroundColor="@color/gray_dot"
                    app:chipStrokeColor="@color/graphite"
                    app:chipStrokeWidth="2.5dp"
                    app:chipCornerRadius="20dp"
                    app:closeIconEnabled="false"
                    app:chipMinHeight="36dp"
                    app:ensureMinTouchTargetSize="false" />

            </com.google.android.material.chip.ChipGroup>

            <!-- Date / Time -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp">

                <TextView
                    android:id="@+id/lblDialogDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Date"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:textColor="@color/graphite"
                    android:fontFamily="@font/bricolagegrotesque_bold"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/lblDialogTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Time"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:textColor="@color/graphite"
                    android:fontFamily="@font/bricolagegrotesque_bold"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="@id/etDialogTime" />

                <EditText
                    android:id="@+id/etDialogDate"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input_field"
                    android:focusable="false"
                    android:clickable="true"
                    android:paddingStart="16dp"
                    android:textSize="14sp"
                    android:fontFamily="@font/pjsans_medium"
                    android:gravity="center_vertical"
                    app:layout_constraintTop_toBottomOf="@id/lblDialogDate"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/etDialogTime"
                    app:layout_constraintWidth_percent="0.47" />

                <EditText
                    android:id="@+id/etDialogTime"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input_field"
                    android:focusable="false"
                    android:clickable="true"
                    android:paddingStart="16dp"
                    android:textSize="14sp"
                    android:fontFamily="@font/pjsans_medium"
                    android:gravity="center_vertical"
                    app:layout_constraintTop_toBottomOf="@id/lblDialogTime"
                    app:layout_constraintStart_toEndOf="@id/etDialogDate"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintWidth_percent="0.47" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Duration -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentBottom="true"
                    android:text="Duration"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@color/graphite"
                    android:fontFamily="@font/bricolagegrotesque_bold" />

                <TextView
                    android:id="@+id/tvDialogDurationValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="1h 30m"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:textColor="@color/graphite"
                    android:fontFamily="@font/bricolagegrotesque_bold" />

            </RelativeLayout>

            <SeekBar
                android:id="@+id/seekDialogDuration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:max="6"
                android:progress="2"
                android:progressDrawable="@drawable/bg_seekbar_track"
                android:thumb="@drawable/bg_fab"
                android:tickMark="@drawable/ic_duration_tick"
                android:splitTrack="false"
                android:minHeight="8dp" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_marginTop="4dp"
                    android:text="30m"
                    android:textSize="12sp"
                    android:textColor="@color/light_graphite"
                    android:fontFamily="@font/bricolagegrotesque_bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_marginTop="4dp"
                    android:text="2h"
                    android:textSize="12sp"
                    android:textColor="@color/light_graphite"
                    android:fontFamily="@font/bricolagegrotesque_bold" />

            </RelativeLayout>

            <!-- Capacity -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:text="Capacity"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@color/graphite"
                    android:fontFamily="@font/bricolagegrotesque_bold" />

                <LinearLayout
                    android:id="@+id/capacityStepperDialog"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_stepper_pill"
                    android:padding="4dp">

                    <TextView
                        android:id="@+id/btnDialogCapacityMinus"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_stepper_circle"
                        android:text="−"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/graphite"
                        android:gravity="center"
                        android:includeFontPadding="false" />

                    <TextView
                        android:id="@+id/tvDialogCapacity"
                        android:layout_width="36dp"
                        android:layout_height="wrap_content"
                        android:text="4"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/graphite"
                        android:gravity="center"
                        android:fontFamily="@font/bricolagegrotesque_bold" />

                    <TextView
                        android:id="@+id/btnDialogCapacityPlus"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_stepper_circle"
                        android:text="+"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/graphite"
                        android:gravity="center"
                        android:includeFontPadding="false" />

                </LinearLayout>

            </RelativeLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- ===== Footer: Save Changes / Cancel (pinned, not scrolled) ===== -->
    <View
        android:id="@+id/bottomDivider"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/graphite"
        app:layout_constraintTop_toBottomOf="@id/scrollDialogContent"
        />
    <LinearLayout
        android:id="@+id/dialogFooter"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/bottomDivider"
        >

        <TextView
            android:id="@+id/btnSaveChanges"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_teal_btn_lite"
            android:text="Save Changes"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@color/graphite"
            android:gravity="center"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:includeFontPadding="false"
            android:fontFamily="@font/bricolagegrotesque_bold"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btnCancelDialog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Cancel"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@color/graphite"
            android:gravity="center"
            android:fontFamily="@font/bricolagegrotesque_bold"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>