<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:background="@drawable/bg_graybox_dropsd"
    android:padding="16dp">

    <TextView
        android:id="@+id/tv_status_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:paddingVertical="2dp"
        android:textSize="12sp"
        android:textStyle="bold"
        android:fontFamily="@font/pjsans_bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="FINISHED"
        android:textColor="#3C4949"
        tools:background="@drawable/bg_finished_pill" />

    <TextView
        android:id="@+id/tv_session_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/graphite"
        android:fontFamily="@font/pjsans_bold"
        app:layout_constraintTop_toBottomOf="@id/tv_status_badge"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="Midterm Review Group" />

    <TextView
        android:id="@+id/tv_datetime"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="12sp"
        android:textColor="@color/graphite"
        android:fontFamily="@font/pjsans_regular"
        app:layout_constraintTop_toBottomOf="@id/tv_session_title"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="Oct 14, 10:00 AM • 2 hours" />

    <ImageView
        android:id="@+id/iv_location_pin"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="4dp"
        android:src="@drawable/ic_location_pin"
        app:layout_constraintTop_toBottomOf="@id/tv_datetime"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tv_location"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:textSize="14sp"
        android:textColor="@color/graphite"
        android:fontFamily="@font/bricolagegrotesque_regular"
        app:layout_constraintTop_toTopOf="@id/iv_location_pin"
        app:layout_constraintBottom_toBottomOf="@id/iv_location_pin"
        app:layout_constraintStart_toEndOf="@id/iv_location_pin"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="Main Library" />

</androidx.constraintlayout.widget.ConstraintLayout>