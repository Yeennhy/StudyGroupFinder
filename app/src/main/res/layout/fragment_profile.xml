<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:background="@drawable/bg_dotted_paper">

    <!-- ===== Scrollable content (sits BEHIND the header) ===== -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/navBar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Spacer so the first card starts below where the header sits. -->
            <View
                android:id="@+id/headerSpacer"
                android:layout_width="0dp"
                android:layout_height="70dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- ===== Card 1: Avatar / Name / ID / bio (plain white card, no header bar) ===== -->
            <LinearLayout
                android:id="@+id/cardAvatar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="20dp"
                android:background="@drawable/bg_whitebox_dropsd"
                app:layout_constraintTop_toBottomOf="@id/headerSpacer"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- Avatar tucked in a fixed circular frame -->
                <FrameLayout
                    android:layout_width="115dp"
                    android:layout_height="115dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="115dp"
                        android:layout_height="115dp"
                        app:cardCornerRadius="9999dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="4.5dp"
                        app:strokeColor="@color/graphite">

                        <ImageView
                            android:id="@+id/ivAvatar"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/ic_profile"
                            android:scaleType="fitCenter"
                            android:padding="35dp"
                            android:contentDescription="Profile picture"
                            tools:ignore="ContentDescription" />

                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEditAvatar"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="bottom|end"
                        android:background="@drawable/bg_fab_lite"
                        app:backgroundTint="@null"
                        android:insetTop="0dp"
                        android:insetBottom="3dp"
                        android:insetLeft="7dp"
                        android:insetRight="0dp"
                        app:icon="@drawable/ic_edit_pencil"
                        app:iconSize="18dp"
                        app:iconTint="@color/graphite"
                        app:iconGravity="textStart"
                        android:padding="0dp"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:visibility="gone"
                        tools:visibility="visible" />

                </FrameLayout>

                <TextView
                    android:id="@+id/tvProfileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Nguyen Van A"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:textColor="@color/graphite"
                    android:fontFamily="@font/bricolagegrotesque_bold" />

                <TextView
                    android:id="@+id/tvEditName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_gravity="start"
                    android:text="Profile Name"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:textColor="@color/graphite"
                    android:fontFamily="@font/bricolagegrotesque_bold"
                    android:visibility="gone"
                    />
                <EditText
                    android:id="@+id/etProfileName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_input_field"
                    android:padding="12dp"
                    android:textSize="18sp"
                    android:textColor="@color/graphite"
                    android:fontFamily="@font/bricolagegrotesque_bold"
                    android:singleLine="true"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvProfileId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_pill_dark"
                    android:text="ID: 24125060"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:fontFamily="@font/bricolagegrotesque_bold" />

                <TextView
                    android:id="@+id/tvResendVerification"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Resend verification email"
                    android:textSize="14sp"
                    android:textColor="@color/graphite"
                    android:visibility="gone"
                    android:fontFamily="@font/pjsans_regular"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/tvProfileBio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="I am PhainonLover6767"
                    android:textSize="16sp"
                    android:textColor="@color/graphite"
                    android:fontFamily="@font/pjsans_medium" />

                <TextView
                    android:id="@+id/tvEditBio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_gravity="start"
                    android:text="Bio"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:textColor="@color/graphite"
                    android:fontFamily="@font/bricolagegrotesque_bold"
                    android:visibility="gone"
                    />
                <EditText
                    android:id="@+id/etProfileBio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_input_field"
                    android:padding="12dp"
                    android:textSize="12sp"
                    android:textColor="@color/graphite"
                    android:fontFamily="@font/pjsans_medium"
                    android:minLines="3"
                    android:gravity="top"
                    android:visibility="gone" />

                <View
                    android:id="@+id/divAvatarCard"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginTop="16dp"
                    android:background="@color/graphite"/>
                <TextView
                    android:id="@+id/blockmsg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="You blocked this user"
                    android:textColor="@color/deep_red"
                    android:fontFamily="@font/pjsans_bold"
                    />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUnblock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_red_btn"
                    app:backgroundTint="@null"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="0dp"
                    android:text="Unblock"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:layout_marginTop="8dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:includeFontPadding="false"
                    android:fontFamily="@font/bricolagegrotesque_bold" />

            </LinearLayout>



            <!-- ===== Card 2: Community (teal header, segmented) ===== -->
            <LinearLayout
                android:id="@+id/cardCommunity"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:paddingStart="4dp"
                android:paddingTop="4dp"
                android:paddingEnd="6dp"
                android:paddingBottom="10dp"
                android:orientation="vertical"
                android:background="@drawable/bg_whitebox_dropsd"
                app:layout_constraintTop_toBottomOf="@id/cardAvatar"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_header_teal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_gradhat"
                        app:tint="@color/graphite" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Community"
                        android:textStyle="bold"
                        android:textSize="20sp"
                        android:textColor="@color/graphite"
                        android:fontFamily="@font/bricolagegrotesque_bold" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:background="@color/graphite" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/white"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvCommunityName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_alignParentStart="true"
                        android:text="HCMUS"
                        android:textSize="16sp"
                        android:textColor="@color/graphite"
                        android:fontFamily="@font/pjsans_medium" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnCommunityArrow"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="2dp"
                        app:strokeColor="@color/graphite"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_chevron_right"
                            android:padding="2dp"
                            app:tint="@color/graphite" />

                    </com.google.android.material.card.MaterialCardView>

                </RelativeLayout>

            </LinearLayout>

            <!-- ===== Card 3: Personal Details (light blue header, segmented) ===== -->
            <LinearLayout
                android:id="@+id/cardPersonalDetails"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:paddingStart="4dp"
                android:paddingTop="4dp"
                android:paddingEnd="6dp"
                android:paddingBottom="10dp"
                android:orientation="vertical"
                android:background="@drawable/bg_whitebox_dropsd"
                app:layout_constraintTop_toBottomOf="@id/cardCommunity"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_header_lblue"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_alignParentStart="true"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_profile"
                            app:tint="@color/graphite" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Personal Details"
                            android:textStyle="bold"
                            android:textSize="20sp"
                            android:textColor="@color/graphite"
                            android:fontFamily="@font/bricolagegrotesque_bold" />

                    </LinearLayout>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnEditDetails"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/white"
                        app:strokeWidth="2dp"
                        app:strokeColor="@color/graphite"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_edit_pencil"
                            app:tint="@color/graphite" />

                    </com.google.android.material.card.MaterialCardView>

                </RelativeLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:background="@color/graphite" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@color/white"
                    android:padding="16dp">

                    <!-- Department row -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:id="@+id/tagDepartment"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:background="@drawable/bg_yellow_pill"
                            android:text="Department"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:textColor="@color/graphite"
                            android:gravity="center"
                            android:paddingStart="12dp"
                            android:paddingEnd="16dp"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp"
                            android:fontFamily="@font/bricolagegrotesque_bold" />

                        <TextView
                            android:id="@+id/tvDepartmentValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:text="Computer Science"
                            android:textSize="14sp"
                            android:textColor="@color/graphite"
                            android:fontFamily="@font/bricolagegrotesque_medium" />

                        <EditText
                            android:id="@+id/etDepartmentValue"
                            android:layout_width="160dp"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:background="@drawable/bg_input_field"
                            android:padding="8dp"
                            android:textSize="13sp"
                            android:textColor="@color/graphite"
                            android:fontFamily="@font/bricolagegrotesque_medium"
                            android:singleLine="true"
                            android:visibility="gone" />

                    </RelativeLayout>

                    <!-- Major row -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:id="@+id/tagMajor"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:background="@drawable/bg_yellow_pill"
                            android:text="Major"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:textColor="@color/graphite"
                            android:gravity="center"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp"
                            android:fontFamily="@font/bricolagegrotesque_bold" />

                        <TextView
                            android:id="@+id/tvMajorValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:text="Software Engineering"
                            android:textSize="14sp"
                            android:textColor="@color/graphite"
                            android:fontFamily="@font/bricolagegrotesque_medium" />

                        <EditText
                            android:id="@+id/etMajorValue"
                            android:layout_width="160dp"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:background="@drawable/bg_input_field"
                            android:padding="8dp"
                            android:textSize="13sp"
                            android:textColor="@color/graphite"
                            android:fontFamily="@font/bricolagegrotesque_medium"
                            android:singleLine="true"
                            android:visibility="gone" />

                    </RelativeLayout>

                    <!-- Admission Year row -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp">

                        <TextView
                            android:id="@+id/tagAdmissionYear"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:background="@drawable/bg_yellow_pill"
                            android:text="Admission Year"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:textColor="@color/graphite"
                            android:gravity="center"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp"
                            android:fontFamily="@font/bricolagegrotesque_bold" />

                        <TextView
                            android:id="@+id/tvAdmissionYearValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:text="2024"
                            android:textSize="14sp"
                            android:textColor="@color/graphite"
                            android:fontFamily="@font/bricolagegrotesque_medium" />

                        <EditText
                            android:id="@+id/etAdmissionYearValue"
                            android:layout_width="100dp"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:background="@drawable/bg_input_field"
                            android:padding="8dp"
                            android:textSize="14sp"
                            android:textColor="@color/graphite"
                            android:fontFamily="@font/bricolagegrotesque_medium"
                            android:inputType="number"
                            android:singleLine="true"
                            android:visibility="gone" />

                    </RelativeLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- ===== Card 4: Session Activity (red/pink header, segmented) ===== -->
            <LinearLayout
                android:id="@+id/cardSessionActivity"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:paddingStart="4dp"
                android:paddingTop="4dp"
                android:paddingEnd="6dp"
                android:paddingBottom="10dp"
                android:orientation="vertical"
                android:background="@drawable/bg_whitebox_dropsd"
                app:layout_constraintTop_toBottomOf="@id/cardPersonalDetails"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_header_red"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_alignParentStart="true"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_profactivity"
                            app:tint="@color/graphite" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Session Activity"
                            android:textStyle="bold"
                            android:textSize="20sp"
                            android:textColor="@color/graphite"
                            android:fontFamily="@font/bricolagegrotesque_bold" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvActivityRange"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:text="Last 90 days"
                        android:textSize="14sp"
                        android:textColor="@color/graphite"
                        android:fontFamily="@font/pjsans_medium" />

                </RelativeLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:background="@color/graphite" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@color/white"
                    android:padding="16dp">

                    <!-- Placeholder image for the contribution/commit graph -->
                    <ImageView
                        android:id="@+id/ivActivityGraph"
                        android:layout_width="match_parent"
                        android:layout_height="110dp"

                        android:src="@drawable/img_activity_placeholder"
                        android:contentDescription="Session activity graph"
                        tools:ignore="ContentDescription" />

                    <!-- Legend -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_gravity="end"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Less"
                            android:textSize="12sp"
                            android:textColor="@color/graphite"
                            android:fontFamily="@font/pjsans_bold" />

                        <View
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:background="@drawable/bg_swatch_gray"
                            android:layout_marginStart="8dp"
                            />


                        <View
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_swatch_lblue" />

                        <View
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_swatch_teal" />

                        <View
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_swatch_yellow" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="More"
                            android:textSize="12sp"
                            android:textColor="@color/graphite"
                            android:fontFamily="@font/pjsans_bold" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- ===== Save Changes button (identical style/format to btnJoinSession) ===== -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveChanges"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_yellow_btn"
                app:backgroundTint="@null"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                android:text="Save Changes"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textSize="20sp"
                android:textColor="@color/graphite"
                android:gravity="center"
                android:paddingTop="18dp"
                android:paddingBottom="18dp"
                android:includeFontPadding="false"
                android:fontFamily="@font/bricolagegrotesque_bold"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/cardSessionActivity"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- ===== Header: drawn on top, cards scroll underneath it ===== -->
    <include
        android:id="@+id/appHeader"
        layout="@layout/layout_app_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bottom navigation bar -->
    <include
        android:id="@+id/navBar"
        layout="@layout/fragment_navbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>
