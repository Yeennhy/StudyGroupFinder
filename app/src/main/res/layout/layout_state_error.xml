<?xml version="1.0" encoding="utf-8"?>
<!-- Reusable error state (§2.1), adapted from the old orphaned fragment_error.
     Wire btnStateRetry to re-run the failed load. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingHorizontal="40dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="88dp"
        android:layout_height="88dp"
        app:cardCornerRadius="9999dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/deep_red"
        app:strokeWidth="4dp"
        app:strokeColor="@color/graphite">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="26dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_x" />

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvStateErrorMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:text="@string/state_error_generic"
        android:textColor="@color/graphite"
        android:textSize="17sp"
        android:fontFamily="@font/bricolagegrotesque_bold" />

    <TextView
        android:id="@+id/tvStateErrorDetail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="@color/graphite"
        android:alpha="0.7"
        android:textSize="13sp"
        android:fontFamily="@font/pjsans_medium"
        android:visibility="gone"
        tools:visibility="visible"
        tools:text="Missing index error message..." />

    <TextView
        android:id="@+id/btnStateRetry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_red_btn"
        android:paddingHorizontal="28dp"
        android:paddingTop="12dp"
        android:paddingBottom="14dp"
        android:text="@string/state_retry"
        android:textAllCaps="false"
        android:textColor="@color/graphite"
        android:textStyle="bold"
        android:fontFamily="@font/bricolagegrotesque_bold" />

</LinearLayout>
