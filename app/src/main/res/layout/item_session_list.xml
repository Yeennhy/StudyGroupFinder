<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="24dp"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_bluebox">

    <!-- Title + time pill -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tvSessionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@id/tvSessionTime"
            android:text="Intro to Algorithms"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="@color/graphite"
            android:fontFamily="@font/pjsans_bold" />

        <TextView
            android:id="@+id/tvSessionTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_pill_unselected"
            android:text="2:00 PM"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="@color/graphite"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:fontFamily="@font/bricolagegrotesque_bold" />

    </RelativeLayout>

    <!-- Location -->
    <TextView
        android:id="@+id/tvSessionLocation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Floor 9 Library"
        android:textSize="14sp"
        android:textColor="@color/graphite"
        android:drawableStart="@drawable/ic_location_pin"
        android:drawablePadding="8dp"
        android:fontFamily="@font/pjsans_regular" />

    <!-- Duration -->
    <TextView
        android:id="@+id/tvSessionDuration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="2 hours"
        android:textSize="14sp"
        android:textColor="@color/graphite"
        android:drawableStart="@drawable/ic_timer"
        android:drawablePadding="8dp"
        android:fontFamily="@font/pjsans_regular" />

    <!-- Spots filled -->
    <TextView
        android:id="@+id/tvSessionSpots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="4 / 6 spots filled"
        android:textSize="14sp"
        android:textColor="@color/graphite"
        android:drawableStart="@drawable/ic_ppl"
        android:drawablePadding="8dp"
        android:fontFamily="@font/pjsans_regular" />

    <!-- View Details button — same style/format as btnJoinSession / btnSaveChanges -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnViewDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_yellow_btn_lite"
        app:backgroundTint="@null"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minHeight="0dp"
        android:text="View Details"
        android:textAllCaps="false"
        android:textStyle="bold"
        android:textSize="14sp"
        android:textColor="@color/graphite"
        android:gravity="center"
        android:paddingTop="14dp"
        android:paddingBottom="16dp"
        android:includeFontPadding="false"
        android:fontFamily="@font/pjsans_bold" />

</LinearLayout>