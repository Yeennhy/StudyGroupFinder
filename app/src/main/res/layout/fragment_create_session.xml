<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dotted_paper">

    <!-- ===== Scrollable content (sits BEHIND the header) ===== -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Spacer so the first card starts below where the header sits.
                 Set this height to match your header's height (or bind it
                 programmatically once appHeader is measured). -->
            <View
                android:id="@+id/headerSpacer"
                android:layout_width="0dp"
                android:layout_height="72dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- ===== Card 1: Title / Description / Goals (light blue) ===== -->
            <LinearLayout
                android:id="@+id/cardBasicInfo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="@drawable/bg_bluebox"
                app:layout_constraintTop_toBottomOf="@id/headerSpacer"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Course ID"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@color/graphite"
                    android:fontFamily="@font/bricolagegrotesque_bold" />

                <EditText
                    android:id="@+id/etCourseId"
                    android:layout_width="match_parent"
                    android:layout_height="41dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="e.g. MTH252"
                    android:textColor="@color/graphite"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:gravity="center_vertical"
                    android:singleLine="true"
                    android:textSize="14sp"
                    android:fontFamily="@font/pjsans_medium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Course Name"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@color/graphite"
                    android:fontFamily="@font/bricolagegrotesque_bold" />

                <EditText
                    android:id="@+id/etCourseName"
                    android:layout_width="match_parent"
                    android:layout_height="41dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="e.g. Calculus II"
                    android:textColor="@color/graphite"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:gravity="center_vertical"
                    android:singleLine="true"
                    android:textSize="14sp"
                    android:fontFamily="@font/pjsans_medium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Course Category"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@color/graphite"
                    android:fontFamily="@font/bricolagegrotesque_bold" />

                <Spinner
                    android:id="@+id/spinnerCourseCategory"
                    android:layout_width="match_parent"
                    android:layout_height="41dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input_field"
                    android:padding="8dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="18dp"
                    android:background="@color/graphite" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Session Title"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@color/graphite"
                    android:fontFamily="@font/bricolagegrotesque_bold" />

                <EditText
                    android:id="@+id/etTitle"
                    android:layout_width="match_parent"
                    android:layout_height="41dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="e.g. Calculus Midterm Review"
                    android:textColor="@color/graphite"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:gravity="center_vertical"
                    android:singleLine="true"
                    android:textSize="14sp"
                    android:fontFamily="@font/pjsans_medium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Description"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@color/graphite"
                    android:fontFamily="@font/bricolagegrotesque_bold" />

                <EditText
                    android:id="@+id/etDescription"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="What are we focusing on?"
                    android:textColor="@color/graphite"
                    android:padding="12dp"
                    android:gravity="top|start"
                    android:inputType="textMultiLine"
                    android:textSize="14sp"
                    android:fontFamily="@font/pjsans_medium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Goals"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@color/graphite"
                    android:fontFamily="@font/bricolagegrotesque_bold" />

                <EditText
                    android:id="@+id/etGoals"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="What are we focusing on?"
                    android:textColor="@color/graphite"
                    android:padding="14dp"
                    android:gravity="top|start"
                    android:inputType="textMultiLine"
                    android:textSize="16sp"
                    android:fontFamily="@font/pjsans_medium" />

            </LinearLayout>

            <!-- ===== Open to All / Only Requests toggle ===== -->
            <LinearLayout
                android:id="@+id/toggleAccessRow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:orientation="horizontal"
                android:background="@drawable/bg_whitebox"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                app:layout_constraintTop_toBottomOf="@id/cardBasicInfo"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/toggleOpenToAll"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_segment_selected"
                    android:text="Open to All"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:textColor="@color/graphite"
                    android:gravity="center"
                    android:padding="8dp"
                    android:includeFontPadding="false"
                    android:fontFamily="@font/bricolagegrotesque_bold" />

                <TextView
                    android:id="@+id/toggleOnlyRequests"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@color/white"
                    android:text="Only Requests"
                    android:textSize="12sp"
                    android:textColor="@color/graphite"
                    android:gravity="center"
                    android:padding="8dp"
                    android:includeFontPadding="false"
                    android:fontFamily="@font/bricolagegrotesque_bold" />

            </LinearLayout>

            <!-- ===== Card 2: Preparing For / Expectation / Tags ===== -->
            <LinearLayout
                android:id="@+id/cardTags"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_whitebox_dropsd"
                app:layout_constraintTop_toBottomOf="@id/toggleAccessRow"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/lblCampus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Campus Location"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:textColor="@color/graphite"
                        android:fontFamily="@font/bricolagegrotesque_bold"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <Spinner
                        android:id="@+id/spinnerCampus"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_input_field"
                        android:padding="8dp"
                        app:layout_constraintTop_toBottomOf="@id/lblCampus"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginTop="18dp"
                    android:background="@color/graphite" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp">

                    <TextView
                        android:id="@+id/lblPreparingFor"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Preparing for"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:textColor="@color/graphite"
                        android:fontFamily="@font/bricolagegrotesque_bold"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/lblExpectation"
                        app:layout_constraintHorizontal_chainStyle="spread_inside" />

                    <TextView
                        android:id="@+id/lblExpectation"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Expectation Level"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:textColor="@color/graphite"
                        android:fontFamily="@font/bricolagegrotesque_bold"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toEndOf="@id/lblPreparingFor"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <Spinner
                        android:id="@+id/spinnerPreparingFor"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_input_field"
                        android:padding="8dp"
                        app:layout_constraintTop_toBottomOf="@id/lblPreparingFor"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/spinnerExpectation"
                        app:layout_constraintWidth_percent="0.47" />

                    <Spinner
                        android:id="@+id/spinnerExpectation"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_input_field"
                        android:padding="8dp"
                        app:layout_constraintTop_toBottomOf="@id/lblExpectation"
                        app:layout_constraintStart_toEndOf="@id/spinnerPreparingFor"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintWidth_percent="0.47" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginTop="18dp"
                    android:background="@color/graphite" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Tags"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:textColor="@color/graphite"
                    android:fontFamily="@font/bricolagegrotesque_bold" />

                <!-- Use a flexbox/chip-group here if tags can wrap to multiple lines;
                     LinearLayout shown for a single row like the reference -->
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/tagContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:chipSpacingHorizontal="8dp"
                    app:chipSpacingVertical="8dp"
                    app:singleLine="false">

                    <TextView
                        android:id="@+id/btnAddTag"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_add_tag_dashed"
                        android:text="+ Add Tag"
                        android:textColor="@color/graphite"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:fontFamily="@font/bricolagegrotesque_bold"
                        android:clickable="true"
                        android:focusable="true" />

                </com.google.android.material.chip.ChipGroup>

            </LinearLayout>

            <!-- ===== Card 3: Date / Time / Duration / Capacity ===== -->
            <LinearLayout
                android:id="@+id/cardSchedule"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_whitebox_dropsd"
                app:layout_constraintTop_toBottomOf="@id/cardTags"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/lblDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Date"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:textColor="@color/graphite"
                        android:fontFamily="@font/bricolagegrotesque_bold"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <TextView
                        android:id="@+id/lblTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Time"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:textColor="@color/graphite"
                        android:fontFamily="@font/bricolagegrotesque_bold"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="@id/etTime" />

                    <EditText
                        android:id="@+id/etDate"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_input_field"
                        android:text="25/08/2026"
                        android:textColor="@color/graphite"
                        android:focusable="false"
                        android:clickable="true"
                        android:paddingStart="16dp"
                        android:textSize="14sp"
                        android:fontFamily="@font/pjsans_medium"
                        android:gravity="center_vertical"
                        app:layout_constraintTop_toBottomOf="@id/lblDate"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/etTime"
                        app:layout_constraintWidth_percent="0.47" />

                    <EditText
                        android:id="@+id/etTime"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_input_field"
                        android:text="04:00 PM"
                        android:textColor="@color/graphite"
                        android:focusable="false"
                        android:clickable="true"
                        android:paddingStart="16dp"
                        android:textSize="14sp"
                        android:fontFamily="@font/pjsans_medium"
                        android:gravity="center_vertical"
                        app:layout_constraintTop_toBottomOf="@id/lblTime"
                        app:layout_constraintStart_toEndOf="@id/etDate"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintWidth_percent="0.47" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Duration -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentBottom="true"
                        android:text="Duration"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="@color/graphite"
                        android:fontFamily="@font/bricolagegrotesque_bold" />

                    <TextView
                        android:id="@+id/tvDurationValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="1h 30m"
                        android:textStyle="bold"
                        android:textSize="20sp"
                        android:textColor="@color/graphite"
                        android:fontFamily="@font/bricolagegrotesque_bold" />

                </RelativeLayout>

                <SeekBar
                    android:id="@+id/seekDuration"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:max="6"
                    android:progress="2"
                    android:progressDrawable="@drawable/bg_seekbar_track"
                    android:thumb="@drawable/bg_slider_thumb"
                    android:thumbOffset="0dp"
                    android:splitTrack="false"
                    android:minHeight="8dp" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_marginTop="4dp"
                        android:text="30m"
                        android:textSize="12sp"
                        android:textColor="@color/light_graphite"
                        android:fontFamily="@font/bricolagegrotesque_bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_marginTop="4dp"
                        android:text="3h30"
                        android:textSize="12sp"
                        android:textColor="@color/light_graphite"
                        android:fontFamily="@font/bricolagegrotesque_bold" />

                </RelativeLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginTop="20dp"
                    android:background="@color/graphite" />

                <!-- Capacity -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:text="Capacity"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="@color/graphite"
                        android:fontFamily="@font/bricolagegrotesque_bold" />

                    <LinearLayout
                        android:id="@+id/capacityStepper"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_stepper_pill"
                        android:padding="4dp">

                        <TextView
                            android:id="@+id/btnCapacityMinus"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_stepper_circle"
                            android:text="−"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/graphite"
                            android:gravity="center"
                            android:includeFontPadding="false" />

                        <TextView
                            android:id="@+id/tvCapacity"
                            android:layout_width="36dp"
                            android:layout_height="wrap_content"
                            android:text="4"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/graphite"
                            android:gravity="center"
                            android:fontFamily="@font/bricolagegrotesque_bold" />

                        <TextView
                            android:id="@+id/btnCapacityPlus"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_stepper_circle"
                            android:text="+"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/graphite"
                            android:gravity="center"
                            android:includeFontPadding="false" />

                    </LinearLayout>

                </RelativeLayout>

            </LinearLayout>

            <!-- ===== Create Session button ===== -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCreateSession"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_yellow_btn"
                app:backgroundTint="@null"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                android:text="Create Session"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textSize="20sp"
                android:textColor="@color/graphite"
                android:gravity="center"
                android:paddingTop="18dp"
                android:paddingBottom="20dp"
                android:includeFontPadding="false"
                android:fontFamily="@font/bricolagegrotesque_bold"
                app:layout_constraintTop_toBottomOf="@id/cardSchedule"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- ===== Header: drawn on top, cards scroll underneath it ===== -->
    <include
        android:id="@+id/appHeader"
        layout="@layout/layout_app_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ===== Reusable UI-state overlays (feature/ui-states) ===== -->
    <include
        android:id="@+id/stateOfflineBanner"
        layout="@layout/layout_state_offline_banner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <include
        android:id="@+id/stateLoading"
        layout="@layout/layout_state_loading"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <include
        android:id="@+id/stateEmpty"
        layout="@layout/layout_state_empty"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <include
        android:id="@+id/stateError"
        layout="@layout/layout_state_error"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
