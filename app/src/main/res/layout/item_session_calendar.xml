<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:paddingStart="4dp"
    android:paddingTop="4dp"
    android:paddingEnd="6dp"
    android:paddingBottom="10dp"
    android:background="@drawable/bg_whitebox_dropsd_lite"
    android:orientation="vertical">

    <!-- ===== Segmented header: title + time pill on colored band ===== -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_header_lblue"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tvSessionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@id/tvSessionTime"
            android:layout_marginEnd="12dp"
            android:text="Calc III Study Group"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@color/graphite"
            android:fontFamily="@font/pjsans_bold" />

        <TextView
            android:id="@+id/tvSessionTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            android:background="@drawable/bg_pill_unselected"
            android:text="2:00 PM"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="@color/graphite"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:fontFamily="@font/bricolagegrotesque_bold" />

    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2.5dp"
        android:background="@color/graphite" />

    <!-- ===== Body: details + View Details button on white ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/white"
        android:padding="16dp">

        <!-- Location -->
        <TextView
            android:id="@+id/tvSessionLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Library Rm 402"
            android:textSize="14sp"
            android:textColor="@color/graphite"
            android:drawableStart="@drawable/ic_location_pin"
            android:drawablePadding="8dp"
            android:fontFamily="@font/pjsans_regular" />

        <!-- Spots filled -->
        <TextView
            android:id="@+id/tvSessionSpots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="8 / 15 spots filled"
            android:textSize="14sp"
            android:textColor="@color/graphite"
            android:drawableStart="@drawable/ic_ppl"
            android:drawablePadding="8dp"
            android:fontFamily="@font/pjsans_regular" />

        <!-- Duration -->
        <TextView
            android:id="@+id/tvSessionDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="1h 30m"
            android:textSize="14sp"
            android:textColor="@color/graphite"
            android:drawableStart="@drawable/ic_timer"
            android:drawablePadding="8dp"
            android:fontFamily="@font/pjsans_regular" />

        <!-- View Details button — same style/format as btnJoinSession / btnSaveChanges -->
        <TextView
            android:id="@+id/btnViewDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_yellow_btn_lite"
            android:text="View Details"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="@color/graphite"
            android:gravity="center"
            android:paddingTop="10dp"
            android:paddingBottom="12dp"
            android:includeFontPadding="false"
            android:fontFamily="@font/pjsans_bold"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</LinearLayout>