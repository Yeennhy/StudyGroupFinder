<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@drawable/bg_dotted_paper">

    <!-- Content scrolls full-bleed from the top edge, underneath the header -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_inbox"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="110dp"
        android:paddingBottom="80dp"
        android:paddingHorizontal="16dp"
        android:scrollbars="none"
        tools:listitem="@layout/item_notification"
        tools:itemCount="4"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Reused header component, floats above the list -->
    <include
        android:id="@+id/header"
        layout="@layout/layout_app_header"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        app:layout_constraintTop_toTopOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>