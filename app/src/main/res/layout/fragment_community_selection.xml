<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:background="@drawable/bg_dotted_paper">

    <include
        android:id="@+id/appHeader"
        layout="@layout/layout_app_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:text="You will only see sessions created by people in your community"
        android:textStyle="bold"
        android:textSize="14sp"
        android:gravity="center"
        android:textColor="@color/graphite"
        android:fontFamily="@font/pjsans_bold"
        app:layout_constraintTop_toBottomOf="@id/appHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Search bar -->
    <EditText
        android:id="@+id/etSearch"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_whitebox_dropsd"
        android:hint="Search for your college"
        android:paddingBottom="2dp"
        android:drawableStart="@drawable/ic_search"
        android:drawablePadding="12dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:gravity="center_vertical"
        android:textSize="16sp"
        android:singleLine="true"
        android:fontFamily="@font/bricolagegrotesque_regular"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Category filter row (All / Universities / STEM / Arts / Social) -->
    <HorizontalScrollView
        android:id="@+id/scrollCategoryFilters"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/etSearch"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <TextView
                android:id="@+id/chipAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_selected"
                android:text="All"
                android:textColor="@color/graphite"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingHorizontal="20dp"
                android:paddingTop="4dp"
                android:paddingBottom="10dp"
                android:fontFamily="@font/pjsans_bold" />

            <TextView
                android:id="@+id/chipUniversities"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textColor="@color/graphite"
                android:background="@drawable/bg_pill_unselected"
                android:text="Universities"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:paddingTop="4dp"
                android:paddingBottom="6dp"
                android:fontFamily="@font/pjsans_bold" />

            <TextView
                android:id="@+id/chipStem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_pill_unselected"
                android:textColor="@color/graphite"
                android:text="STEM"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:paddingTop="4dp"
                android:paddingBottom="6dp"
                android:fontFamily="@font/pjsans_bold" />

            <TextView
                android:id="@+id/chipArts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_pill_unselected"
                android:text="Arts"
                android:textColor="@color/graphite"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:paddingTop="4dp"
                android:paddingBottom="6dp"
                android:fontFamily="@font/pjsans_bold" />

            <TextView
                android:id="@+id/chipSocial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_pill_unselected"
                android:text="Social"
                android:textColor="@color/graphite"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:paddingTop="4dp"
                android:paddingBottom="6dp"
                android:fontFamily="@font/pjsans_bold" />

        </LinearLayout>

    </HorizontalScrollView>

    <!-- Community cards grid -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCommunities"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:clipChildren="false"
        android:clipToOutline="false"
        android:clipToPadding="false"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="20dp"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:spanCount="2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/scrollCategoryFilters"
        tools:listitem="@layout/item_community"
        tools:itemCount="4"
        tools:spanCount="2" />

</androidx.constraintlayout.widget.ConstraintLayout>