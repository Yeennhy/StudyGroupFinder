<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="true"
    android:clipToPadding="true"
    android:background="@drawable/bg_dotted_paper">

    <!-- Subtitle -->
    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:text="You will only see sessions created by people in your community"
        android:textStyle="bold"
        android:textSize="14sp"
        android:gravity="center"
        android:textColor="@color/graphite"
        android:fontFamily="@font/pjsans_bold"
        app:layout_constraintTop_toBottomOf="@id/headerSpacer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Spacer to account for header height -->
    <View
        android:id="@+id/headerSpacer"
        android:layout_width="0dp"
        android:layout_height="70dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Search bar -->
    <EditText
        android:id="@+id/etSearch"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_whitebox_dropsd"
        android:hint="Search for your college"
        android:textColor="@color/graphite"
        android:paddingBottom="2dp"
        android:drawableStart="@drawable/ic_search"
        android:drawablePadding="12dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:gravity="center_vertical"
        android:textSize="16sp"
        android:singleLine="true"
        android:fontFamily="@font/bricolagegrotesque_regular"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- City filter chips row -->
    <HorizontalScrollView
        android:id="@+id/scrollCityChips"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/etSearch"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/rowCityChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp" />

    </HorizontalScrollView>

    <!-- Legacy category filter row — kept in tree but hidden (§7.1 decision). -->
    <HorizontalScrollView
        android:id="@+id/scrollCategoryFilters"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:scrollbars="none"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/etSearch"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <TextView
                android:id="@+id/chipAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_selected"
                android:text="All"
                android:textColor="@color/graphite"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="19dp"
                android:paddingTop="4dp"
                android:paddingBottom="10dp"
                android:fontFamily="@font/pjsans_bold" />

            <TextView
                android:id="@+id/chipUniversities"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textColor="@color/graphite"
                android:background="@drawable/bg_pill_unselected_offset"
                android:text="Universities"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="19dp"
                android:paddingTop="4dp"
                android:paddingBottom="7dp"
                android:fontFamily="@font/pjsans_bold" />

            <TextView
                android:id="@+id/chipStem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_pill_unselected_offset"
                android:textColor="@color/graphite"
                android:text="STEM"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="19dp"
                android:paddingTop="4dp"
                android:paddingBottom="7dp"
                android:fontFamily="@font/pjsans_bold" />

            <TextView
                android:id="@+id/chipArts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_pill_unselected_offset"
                android:text="Arts"
                android:textColor="@color/graphite"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="19dp"
                android:paddingTop="4dp"
                android:paddingBottom="7dp"
                android:fontFamily="@font/pjsans_bold" />

            <TextView
                android:id="@+id/chipSocial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_pill_unselected_offset"
                android:text="Social"
                android:textColor="@color/graphite"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="19dp"
                android:paddingTop="4dp"
                android:paddingBottom="7dp"
                android:fontFamily="@font/pjsans_bold" />

        </LinearLayout>

    </HorizontalScrollView>

    <!-- Content area for list and states (isolated for smooth transitions) -->
    <FrameLayout
        android:id="@+id/layoutCommunityListContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/scrollCityChips"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCommunities"
            android:layoutAnimation="@anim/layout_animation_slide_up"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="true"
            android:clipToOutline="false"
            android:clipToPadding="true"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="20dp"
            tools:listitem="@layout/item_community"
            tools:itemCount="4" />

        <!-- ===================== UI states (§7.1 / §2.1) ===================== -->

        <include
            android:id="@+id/stateLoading"
            layout="@layout/layout_state_loading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <include
            android:id="@+id/stateEmpty"
            layout="@layout/layout_state_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <include
            android:id="@+id/stateError"
            layout="@layout/layout_state_error"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <include
            android:id="@+id/stateOfflineBanner"
            layout="@layout/layout_state_offline_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:visibility="gone" />

    </FrameLayout>

    <!-- Header moved to end to be on top -->
    <include
        android:id="@+id/appHeader"
        layout="@layout/layout_app_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>