<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:background="@drawable/bg_dotted_paper">

    <include
        android:id="@+id/appHeader"
        layout="@layout/layout_app_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:text="You will only see sessions created by people in your community"
        android:textStyle="bold"
        android:textSize="14sp"
        android:gravity="center"
        android:textColor="@color/graphite"
        android:fontFamily="@font/pjsans_bold"
        app:layout_constraintTop_toBottomOf="@id/appHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Search bar -->
    <EditText
        android:id="@+id/etSearch"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_whitebox_dropsd"
        android:hint="Search for your college"
        android:textColor="@color/graphite"
        android:paddingBottom="2dp"
        android:drawableStart="@drawable/ic_search"
        android:drawablePadding="12dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:gravity="center_vertical"
        android:textSize="16sp"
        android:singleLine="true"
        android:fontFamily="@font/bricolagegrotesque_regular"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- City filter chips (§7.1) — filled at runtime from the REST list.
         Replaces the old category chips, which mapped to no Community field. -->
    <HorizontalScrollView
        android:id="@+id/scrollCityChips"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/etSearch"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/rowCityChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp" />

    </HorizontalScrollView>

    <TextView
        android:id="@+id/bannerOfflineCommunities"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/theme_gray"
        android:gravity="center"
        android:padding="6dp"
        android:text="@string/state_offline_banner"
        android:textColor="@color/graphite"
        android:textSize="12sp"
        android:fontFamily="@font/pjsans_bold"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/scrollCityChips"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="gone" />

    <!-- Legacy category filter row — kept in tree but hidden (§7.1 decision). -->
    <HorizontalScrollView
        android:id="@+id/scrollCategoryFilters"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:scrollbars="none"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/etSearch"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <TextView
                android:id="@+id/chipAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_selected"
                android:text="All"
                android:textColor="@color/graphite"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="19dp"
                android:paddingTop="4dp"
                android:paddingBottom="10dp"
                android:fontFamily="@font/pjsans_bold" />

            <TextView
                android:id="@+id/chipUniversities"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textColor="@color/graphite"
                android:background="@drawable/bg_pill_unselected_offset"
                android:text="Universities"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="19dp"
                android:paddingTop="4dp"
                android:paddingBottom="7dp"
                android:fontFamily="@font/pjsans_bold" />

            <TextView
                android:id="@+id/chipStem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_pill_unselected_offset"
                android:textColor="@color/graphite"
                android:text="STEM"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="19dp"
                android:paddingTop="4dp"
                android:paddingBottom="7dp"
                android:fontFamily="@font/pjsans_bold" />

            <TextView
                android:id="@+id/chipArts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_pill_unselected_offset"
                android:text="Arts"
                android:textColor="@color/graphite"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="19dp"
                android:paddingTop="4dp"
                android:paddingBottom="7dp"
                android:fontFamily="@font/pjsans_bold" />

            <TextView
                android:id="@+id/chipSocial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_pill_unselected_offset"
                android:text="Social"
                android:textColor="@color/graphite"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="19dp"
                android:paddingTop="4dp"
                android:paddingBottom="7dp"
                android:fontFamily="@font/pjsans_bold" />

        </LinearLayout>

    </HorizontalScrollView>

    <!-- Community cards grid -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCommunities"
        android:layoutAnimation="@anim/layout_animation_slide_up"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:clipChildren="false"
        android:clipToOutline="false"
        android:clipToPadding="false"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="20dp"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:spanCount="2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/scrollCityChips"
        tools:listitem="@layout/item_community"
        tools:itemCount="4"
        tools:spanCount="2" />

    <!-- ===================== UI states (§7.1 / §2.1) ===================== -->

    <ProgressBar
        android:id="@+id/progressCommunities"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/rvCommunities"
        app:layout_constraintBottom_toBottomOf="@id/rvCommunities"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="gone" />

    <TextView
        android:id="@+id/tvEmptyCommunities"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:gravity="center"
        android:text="@string/communities_empty"
        android:textColor="@color/graphite"
        android:textSize="15sp"
        android:fontFamily="@font/pjsans_regular"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/rvCommunities"
        app:layout_constraintBottom_toBottomOf="@id/rvCommunities"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="gone" />

    <LinearLayout
        android:id="@+id/layoutErrorCommunities"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/rvCommunities"
        app:layout_constraintBottom_toBottomOf="@id/rvCommunities"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/communities_error"
            android:textColor="@color/graphite"
            android:textSize="15sp"
            android:fontFamily="@font/pjsans_regular" />

        <TextView
            android:id="@+id/btnRetryCommunities"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_pill_selected"
            android:text="@string/state_retry"
            android:textColor="@color/graphite"
            android:textStyle="bold"
            android:paddingStart="20dp"
            android:paddingEnd="23dp"
            android:paddingTop="8dp"
            android:paddingBottom="11dp"
            android:fontFamily="@font/pjsans_bold" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>