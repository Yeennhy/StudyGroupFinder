<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:background="@drawable/bg_dotted_paper"
    android:theme="@style/Theme.MaterialComponents.Light">

    <!-- ===== Scrollable content (sits BEHIND the header) ===== -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Spacer so the first card starts below where the header sits.
                 Match this to appHeader's actual rendered height. -->
            <View
                android:id="@+id/headerSpacer"
                android:layout_width="0dp"
                android:layout_height="70dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- ===== Card 1: Title / Time / Duration / Location / Tags ===== -->
            <LinearLayout
                android:id="@+id/cardInfo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="@drawable/bg_whitebox_dropsd"
                app:layout_constraintTop_toBottomOf="@id/headerSpacer"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/tvSessionTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Data Structures Review"
                        android:textStyle="bold"
                        android:textSize="22sp"
                        android:textColor="@color/graphite"
                        android:fontFamily="@font/bricolagegrotesque_bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/btnMarkFinished"
                        android:layout_marginEnd="8dp" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnMarkFinished"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="2dp"
                        app:strokeColor="@color/graphite"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/ic_tick"
                            android:scaleType="fitCenter"
                            android:padding="8dp"
                            app:tint="@color/graphite" />

                    </com.google.android.material.card.MaterialCardView>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_clock"
                        app:tint="@color/graphite" />

                    <TextView
                        android:id="@+id/tvSessionTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Today, 4:00 PM"
                        android:textSize="14sp"
                        android:textColor="@color/graphite"
                        android:fontFamily="@font/pjsans_medium" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_timer"
                        app:tint="@color/graphite" />

                    <TextView
                        android:id="@+id/tvSessionDuration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="2 hours"
                        android:textSize="14sp"
                        android:textColor="@color/graphite"
                        android:fontFamily="@font/pjsans_medium" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_location_pin"
                        app:tint="@color/graphite" />

                    <TextView
                        android:id="@+id/tvSessionLocation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Library, 3rd Floor Study Room B"
                        android:textSize="14sp"
                        android:textColor="@color/graphite"
                        android:fontFamily="@font/pjsans_medium" />

                </LinearLayout>

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/tagContainerInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:chipSpacingHorizontal="8dp"
                    app:chipSpacingVertical="8dp"
                    app:singleLine="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/tagMidterm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Midterm"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:textColor="@color/graphite"
                        android:fontFamily="@font/bricolagegrotesque_bold"
                        app:chipBackgroundColor="@color/ginkgo_yellow"
                        app:chipStrokeColor="@color/graphite"
                        app:chipStrokeWidth="2.5dp"
                        app:chipCornerRadius="20dp"
                        app:closeIconEnabled="false"
                        app:chipMinHeight="28dp"
                        app:ensureMinTouchTargetSize="false" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/tagGrind"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Grind"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:textColor="@color/graphite"
                        android:fontFamily="@font/pjsans_bold"
                        app:chipBackgroundColor="@color/light_blue"
                        app:chipStrokeColor="@color/graphite"
                        app:chipStrokeWidth="2.5dp"
                        app:chipCornerRadius="20dp"
                        app:closeIconEnabled="false"
                        app:chipMinHeight="28dp"
                        app:ensureMinTouchTargetSize="false" />

                </com.google.android.material.chip.ChipGroup>

            </LinearLayout>

            <!-- ===== Card 2: Description + Agenda (light blue) ===== -->
            <LinearLayout
                android:id="@+id/cardDescription"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_bluebox"
                app:layout_constraintTop_toBottomOf="@id/cardInfo"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_description" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Description"
                        android:textStyle="bold"
                        android:textSize="20sp"
                        android:textColor="@color/graphite"
                        android:fontFamily="@font/bricolagegrotesque_bold" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvSessionDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Final review session before the midterm. We'll be focusing heavily on reaction mechanisms and stereochemistry. Bring your practice problems!"
                    android:textSize="14sp"
                    android:textColor="@color/graphite"
                    android:fontFamily="@font/pjsans_regular"
                    android:lineHeight="24sp" />

                <!-- Agenda (dashed box) -->
                <LinearLayout
                    android:id="@+id/boxAgenda"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    android:background="@drawable/bg_agenda_box"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Agenda"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="@color/graphite"
                        android:fontFamily="@font/bricolagegrotesque_bold" />

                    <TextView
                        android:id="@+id/tvAgenda"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="- Goal 1\n- Goal 2\n- Goal 3"
                        android:textColor="@color/graphite"
                        android:maxLines="10"
                        android:lineHeight="24sp"
                        android:ellipsize="end"
                        android:gravity="top|start"
                        android:inputType="textMultiLine"
                        android:textSize="14sp"
                        android:fontFamily="@font/pjsans_medium" />

                </LinearLayout>

            </LinearLayout>

            <!-- ===== Card 3: Materials (yellow) ===== -->
            <LinearLayout
                android:id="@+id/cardMaterials"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:orientation="vertical"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@drawable/bg_yellowbox"
                app:layout_constraintTop_toBottomOf="@id/cardDescription"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_alignParentStart="true"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_attachment" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Materials"
                            android:textStyle="bold"
                            android:textSize="20sp"
                            android:textColor="@color/graphite"
                            android:fontFamily="@font/bricolagegrotesque_bold" />

                    </LinearLayout>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/upload_btn_container"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="2dp"
                        app:strokeColor="@color/graphite"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:layout_alignParentEnd="true"
                        >

                        <ImageButton
                            android:id="@+id/upload_btn"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/ic_upload"
                            android:scaleType="fitCenter"
                            android:padding="10dp"
                            app:tint="@color/graphite"
                            android:clickable="false"
                            android:focusable="false"
                            android:background="@android:color/white"
                            android:backgroundTint="@android:color/white" />

                    </com.google.android.material.card.MaterialCardView>
                </RelativeLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvMaterials"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:nestedScrollingEnabled="false"
                    tools:itemCount="2"
                    tools:listitem="@layout/item_file_row" />

            </LinearLayout>

            <!-- ===== Card 3.5: Pending Requests (yellow) ===== -->
            <LinearLayout
                android:id="@+id/cardPendingRq"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:orientation="vertical"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@drawable/bg_yellowbox"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/cardMaterials"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_bell" />

                    <TextView
                        android:id="@+id/tvPendingCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Pending Requests (0)"
                        android:textStyle="bold"
                        android:textSize="20sp"
                        android:textColor="@color/graphite"
                        android:fontFamily="@font/bricolagegrotesque_bold" />

                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvPendingRequests"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:nestedScrollingEnabled="false"
                    tools:itemCount="2"
                    tools:listitem="@layout/item_attendee_row" />

            </LinearLayout>

            <!-- ===== Card 4: Attendees (gray) ===== -->
            <LinearLayout
                android:id="@+id/cardAttendees"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="@drawable/bg_graybox"
                app:layout_constraintTop_toBottomOf="@id/cardPendingRq"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_ppl" />

                    <TextView
                        android:id="@+id/tvAttendeesCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Attendees (4/6)"
                        android:textStyle="bold"
                        android:textSize="20sp"
                        android:textColor="@color/graphite"
                        android:fontFamily="@font/bricolagegrotesque_bold" />

                </LinearLayout>

                <!-- Host row -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/rowHost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_tealbox"
                    android:padding="12dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent">

                    <com.google.android.material.card.MaterialCardView
                        android:theme="@style/Theme.MaterialComponents.Light"
                        android:id="@+id/ivAvatarFrame"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        app:cardCornerRadius="9999dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="2dp"
                        app:strokeColor="@color/graphite"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <ImageView
                            android:id="@+id/ivAvatar"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitCenter"
                            android:padding="10dp"
                            android:src="@drawable/ic_profile" />

                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical"
                        app:layout_constraintStart_toEndOf="@id/ivAvatarFrame"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <TextView
                            android:id="@+id/tvHostName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Nguyen Van A (Host)"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:textColor="@color/graphite"
                            android:fontFamily="@font/pjsans_bold" />

                        <TextView
                            android:id="@+id/tvHostId"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="24120000"
                            android:textSize="13sp"
                            android:textColor="@color/graphite"
                            android:fontFamily="@font/pjsans_regular" />

                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Attendee rows (repeatable via RecyclerView) -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvAttendees"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    tools:itemCount="3"
                    tools:listitem="@layout/item_attendee_row" />

                <!-- Invite more students -->
                <RelativeLayout
                    android:id="@+id/rowInviteStudents"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_dashed_row"
                    android:padding="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <FrameLayout
                        android:id="@+id/btnInviteAdd"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:background="@drawable/bg_invite_circle">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="+"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/graphite"
                            android:includeFontPadding="false" />

                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_toEndOf="@id/btnInviteAdd"
                        android:layout_marginStart="12dp"
                        android:text="Invite more students"
                        android:textSize="14sp"
                        android:textColor="@color/graphite"
                        android:fontFamily="@font/pjsans_regular" />

                </RelativeLayout>

            </LinearLayout>

            <!-- ===== Join Session button ===== -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnJoinSession"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_yellow_btn"
                app:backgroundTint="@null"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                android:text="Join Session"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textSize="20sp"
                android:textColor="@color/graphite"
                android:gravity="center"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:includeFontPadding="false"
                android:fontFamily="@font/bricolagegrotesque_bold"
                app:layout_constraintTop_toBottomOf="@id/cardAttendees"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- ===== Header: drawn on top, cards scroll underneath it ===== -->
    <include
        android:id="@+id/appHeader"
        layout="@layout/layout_app_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ===== Reusable UI-state overlays (feature/ui-states) ===== -->
    <include
        android:id="@+id/stateOfflineBanner"
        layout="@layout/layout_state_offline_banner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <include
        android:id="@+id/stateLoading"
        layout="@layout/layout_state_loading"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <include
        android:id="@+id/stateEmpty"
        layout="@layout/layout_state_empty"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <include
        android:id="@+id/stateError"
        layout="@layout/layout_state_error"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Action Loading Overlay -->
    <FrameLayout
        android:id="@+id/actionLoadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">
        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>