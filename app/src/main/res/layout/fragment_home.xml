<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="true"
    android:clipToPadding="true"
    android:background="@drawable/bg_dotted_paper">

    <!-- Session cards list - moved to top for lowest Z-order (drawn first) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSessions"
        android:layoutAnimation="@anim/layout_animation_slide_up"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:clipChildren="true"
        android:clipToOutline="false"
        android:clipToPadding="true"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="4dp"
        android:paddingBottom="20dp"
        app:layout_constraintBottom_toTopOf="@id/navBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/scrollToggleFilters"
        app:layout_constraintVertical_bias="0.0"
        tools:listitem="@layout/item_home_session" />

    <!-- Search bar -->
    <EditText
        android:id="@+id/etSearch"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="88dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_whitebox_dropsd"
        android:hint="Search for name, course ID, etc."
        android:textColor="@color/graphite"
        android:drawableStart="@drawable/ic_search"
        android:drawablePadding="12dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:gravity="center_vertical"
        android:textSize="16sp"
        android:singleLine="true"
        android:fontFamily="@font/bricolagegrotesque_regular"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Category filter row (All Sessions / Midterm / Final / Review) -->
    <HorizontalScrollView
        android:id="@+id/scrollCategoryFilters"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/etSearch"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <TextView
                android:id="@+id/chipAllSessions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_selected"
                android:text="All Sessions"
                android:textColor="@color/graphite"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="19dp"
                android:paddingTop="8dp"
                android:paddingBottom="11dp"
                android:fontFamily="@font/pjsans_bold" />

            <TextView
                android:id="@+id/chipMidterm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pill_unselected_offset"
                android:text="Midterm"
                android:textColor="@color/graphite"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="19dp"
                android:paddingTop="8dp"
                android:paddingBottom="11dp"
                android:fontFamily="@font/pjsans_bold" />

            <TextView
                android:id="@+id/chipFinal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pill_unselected_offset"
                android:text="Final"
                android:textColor="@color/graphite"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="19dp"
                android:paddingTop="8dp"
                android:paddingBottom="11dp"
                android:fontFamily="@font/pjsans_bold" />

            <TextView
                android:id="@+id/chipReview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_pill_unselected_offset"
                android:text="Review"
                android:textColor="@color/graphite"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="19dp"
                android:paddingTop="8dp"
                android:paddingBottom="11dp"
                android:fontFamily="@font/pjsans_bold" />

        </LinearLayout>

    </HorizontalScrollView>

    <!-- Course-type filter row (CourseCategory, §7.2) -->
    <HorizontalScrollView
        android:id="@+id/scrollCourseTypeFilters"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:scrollbars="none"
        android:contentDescription="@string/cd_category_filter"
        app:layout_constraintTop_toBottomOf="@id/scrollCategoryFilters"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <TextView android:id="@+id/chipTypeAll" style="@style/HomeFilterPillSelected" android:text="All Types" />
            <TextView android:id="@+id/chipTypePhysics" style="@style/HomeFilterPill" android:text="Physics" />
            <TextView android:id="@+id/chipTypeCalculus" style="@style/HomeFilterPill" android:text="Calculus" />
            <TextView android:id="@+id/chipTypeDsa" style="@style/HomeFilterPill" android:text="DSA" />
            <TextView android:id="@+id/chipTypeProgramming" style="@style/HomeFilterPill" android:text="Programming" />
            <TextView android:id="@+id/chipTypeEnglish" style="@style/HomeFilterPill" android:text="English" />
            <TextView android:id="@+id/chipTypeArts" style="@style/HomeFilterPill" android:text="Arts" />
            <TextView android:id="@+id/chipTypeSocial" style="@style/HomeFilterPill" android:text="Social" />
            <TextView android:id="@+id/chipTypeOther" style="@style/HomeFilterPill" android:text="Other" />

        </LinearLayout>

    </HorizontalScrollView>

    <!-- Expectation-level filter row (ExpectationLevel, §7.2) -->
    <HorizontalScrollView
        android:id="@+id/scrollExpectationFilters"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/scrollCourseTypeFilters"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <TextView android:id="@+id/chipExpAll" style="@style/HomeFilterPillSelected" android:text="All Levels" />
            <TextView android:id="@+id/chipExpPass" style="@style/HomeFilterPill" android:text="Pass" />
            <TextView android:id="@+id/chipExpCasual" style="@style/HomeFilterPill" android:text="Casual" />
            <TextView android:id="@+id/chipExpGrind" style="@style/HomeFilterPill" android:text="Overachieving" />

        </LinearLayout>

    </HorizontalScrollView>

    <!-- Toggle + sort row (Conflicting sessions / Sort) -->
    <HorizontalScrollView
        android:id="@+id/scrollToggleFilters"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/scrollExpectationFilters"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <ImageButton
                android:id="@+id/btnExpandFilters"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@drawable/bg_toggle_unselected_offset"
                android:src="@drawable/ic_chevron_right"
                android:contentDescription="@string/home_toggle_filters_cd"
                android:scaleType="centerInside"
                android:paddingTop="8dp"
                android:paddingBottom="11dp"
                android:rotation="90"
                android:minHeight="0dp"
                android:minWidth="0dp"
                app:tint="@color/graphite"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintTop_toTopOf="@id/tvSort"
                app:layout_constraintBottom_toBottomOf="@id/tvSort"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/tvSort"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_toggle_unselected_offset"
                android:text="@string/home_sort_label"
                android:textColor="@color/graphite"
                android:textStyle="bold"
                android:gravity="center"
                android:drawableEnd="@drawable/ic_timer"
                android:drawablePadding="6dp"
                android:paddingStart="16dp"
                android:paddingEnd="19dp"
                android:paddingTop="8dp"
                android:paddingBottom="11dp"
                android:fontFamily="@font/pjsans_bold"
                app:layout_constraintStart_toEndOf="@id/btnExpandFilters"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <TextView
                android:id="@+id/toggleConflicting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_toggle_unselected_offset"
                android:text="Hide Conflicts"
                android:textColor="@color/graphite"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="19dp"
                android:paddingTop="8dp"
                android:paddingBottom="11dp"
                android:fontFamily="@font/pjsans_bold"
                app:layout_constraintStart_toEndOf="@id/tvSort"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <TextView
                android:id="@+id/toggleGrind"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_toggle_unselected_offset"
                android:text="Grind"
                android:textColor="@color/graphite"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:fontFamily="@font/pjsans_bold"
                android:visibility="gone"
                app:layout_constraintStart_toEndOf="@id/toggleConflicting"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <TextView
                android:id="@+id/toggleCasual"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_toggle_unselected_offset"
                android:text="Casual"
                android:textColor="@color/graphite"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:fontFamily="@font/pjsans_bold"
                android:visibility="gone"
                app:layout_constraintStart_toEndOf="@id/toggleGrind"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </HorizontalScrollView>

    <!-- ===================== UI states (§7.2 / §2.1) ===================== -->

    <include
        android:id="@+id/stateLoading"
        layout="@layout/layout_state_loading"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/scrollToggleFilters"
        app:layout_constraintBottom_toTopOf="@id/navBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <include
        android:id="@+id/stateEmpty"
        layout="@layout/layout_state_empty"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/scrollToggleFilters"
        app:layout_constraintBottom_toTopOf="@id/navBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <include
        android:id="@+id/stateError"
        layout="@layout/layout_state_error"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/scrollToggleFilters"
        app:layout_constraintBottom_toTopOf="@id/navBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <include
        android:id="@+id/stateOfflineBanner"
        layout="@layout/layout_state_offline_banner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/scrollToggleFilters"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <FrameLayout
        android:id="@+id/fabAdd"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_fab"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:paddingEnd="3dp"
        android:paddingBottom="4dp"
        android:elevation="8dp"
        app:layout_constraintBottom_toTopOf="@id/navBar"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="+"
            android:textColor="@color/graphite"
            android:textSize="32sp"
            android:textStyle="bold"
            android:includeFontPadding="false" />

    </FrameLayout>

    <!-- Bottom navigation bar -->
    <include
        android:id="@+id/navBar"
        layout="@layout/fragment_navbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Reused header include (yellow bar, title, hourglass icon) —
         drawn last so it renders above the search bar / filters / list,
         which now start from the top of the screen and scroll underneath it -->
    <include
        android:id="@+id/appHeader"
        layout="@layout/layout_app_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>