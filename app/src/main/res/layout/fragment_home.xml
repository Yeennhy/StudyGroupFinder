<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:background="@drawable/bg_dotted_paper">

    <!-- Search bar -->
    <EditText
        android:id="@+id/etSearch"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="88dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_whitebox_dropsd"
        android:hint="Search for name, course ID, etc."
        android:textColor="@color/graphite"
        android:drawableStart="@drawable/ic_search"
        android:drawablePadding="12dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:gravity="center_vertical"
        android:textSize="16sp"
        android:singleLine="true"
        android:fontFamily="@font/bricolagegrotesque_regular"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Category filter row (All Sessions / Midterm / Final / Review) -->
    <HorizontalScrollView
        android:id="@+id/scrollCategoryFilters"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/etSearch"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <TextView
                android:id="@+id/chipAllSessions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_selected"
                android:text="All Sessions"
                android:textColor="@color/graphite"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="11dp"
                android:fontFamily="@font/pjsans_bold" />

            <TextView
                android:id="@+id/chipMidterm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pill_unselected"
                android:text="Midterm"
                android:textColor="@color/graphite"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:fontFamily="@font/pjsans_bold" />

            <TextView
                android:id="@+id/chipFinal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pill_unselected"
                android:text="Final"
                android:textColor="@color/graphite"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:fontFamily="@font/pjsans_bold" />

            <TextView
                android:id="@+id/chipReview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_pill_unselected"
                android:text="Review"
                android:textColor="@color/graphite"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:fontFamily="@font/pjsans_bold" />

        </LinearLayout>

    </HorizontalScrollView>

    <!-- Course-type filter row (CourseCategory, §7.2) -->
    <HorizontalScrollView
        android:id="@+id/scrollCourseTypeFilters"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:scrollbars="none"
        android:contentDescription="@string/cd_category_filter"
        app:layout_constraintTop_toBottomOf="@id/scrollCategoryFilters"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <TextView android:id="@+id/chipTypeAll" style="@style/HomeFilterPillSelected" android:text="All Types" />
            <TextView android:id="@+id/chipTypePhysics" style="@style/HomeFilterPill" android:text="Physics" />
            <TextView android:id="@+id/chipTypeCalculus" style="@style/HomeFilterPill" android:text="Calculus" />
            <TextView android:id="@+id/chipTypeDsa" style="@style/HomeFilterPill" android:text="DSA" />
            <TextView android:id="@+id/chipTypeProgramming" style="@style/HomeFilterPill" android:text="Programming" />
            <TextView android:id="@+id/chipTypeEnglish" style="@style/HomeFilterPill" android:text="English" />
            <TextView android:id="@+id/chipTypeArts" style="@style/HomeFilterPill" android:text="Arts" />
            <TextView android:id="@+id/chipTypeSocial" style="@style/HomeFilterPill" android:text="Social" />
            <TextView android:id="@+id/chipTypeOther" style="@style/HomeFilterPill" android:text="Other" />

        </LinearLayout>

    </HorizontalScrollView>

    <!-- Toggle + sort row (Conflicting sessions / Sort) -->
    <HorizontalScrollView
        android:id="@+id/scrollToggleFilters"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/scrollCourseTypeFilters"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <TextView
                android:id="@+id/tvSort"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_toggle_unselected"
                android:text="@string/home_sort_label"
                android:textColor="@color/graphite"
                android:textStyle="bold"
                android:gravity="center"
                android:drawableEnd="@drawable/ic_timer"
                android:drawablePadding="6dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:fontFamily="@font/pjsans_bold" />

            <TextView
                android:id="@+id/toggleConflicting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_toggle_unselected"
                android:text="Conflicting sessions"
                android:textColor="@color/graphite"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="11dp"
                android:fontFamily="@font/pjsans_bold" />

            <TextView
                android:id="@+id/toggleGrind"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_toggle_unselected"
                android:text="Grind"
                android:textColor="@color/graphite"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:fontFamily="@font/pjsans_bold" />

            <TextView
                android:id="@+id/toggleCasual"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_toggle_unselected"
                android:text="Casual"
                android:textColor="@color/graphite"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:fontFamily="@font/pjsans_bold" />

        </LinearLayout>

    </HorizontalScrollView>

    <!-- Session cards list -->

    <!-- FAB -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSessions"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:clipChildren="false"
        android:clipToOutline="false"
        android:clipToPadding="false"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp"
        app:layout_constraintBottom_toTopOf="@id/navBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/scrollToggleFilters"
        app:layout_constraintVertical_bias="0.0"
        tools:listitem="@layout/item_home_session" />

    <!-- ===================== UI states (§7.2 / §2.1) ===================== -->

    <ProgressBar
        android:id="@+id/progressHome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/rvSessions"
        app:layout_constraintBottom_toBottomOf="@id/rvSessions"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="gone" />

    <TextView
        android:id="@+id/tvEmptyHome"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:gravity="center"
        android:text="@string/home_empty"
        android:textColor="@color/graphite"
        android:textSize="15sp"
        android:fontFamily="@font/pjsans_regular"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/rvSessions"
        app:layout_constraintBottom_toBottomOf="@id/rvSessions"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="gone" />

    <LinearLayout
        android:id="@+id/layoutErrorHome"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/rvSessions"
        app:layout_constraintBottom_toBottomOf="@id/rvSessions"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/home_error"
            android:textColor="@color/graphite"
            android:textSize="15sp"
            android:fontFamily="@font/pjsans_regular" />

        <TextView
            android:id="@+id/btnRetryHome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_pill_selected"
            android:text="@string/state_retry"
            android:textColor="@color/graphite"
            android:textStyle="bold"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="10dp"
            android:fontFamily="@font/pjsans_bold" />

    </LinearLayout>

    <TextView
        android:id="@+id/bannerOfflineHome"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/theme_gray"
        android:gravity="center"
        android:padding="6dp"
        android:text="@string/state_offline_banner"
        android:textColor="@color/graphite"
        android:textSize="12sp"
        android:fontFamily="@font/pjsans_bold"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/scrollToggleFilters"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="gone" />

    <FrameLayout
        android:id="@+id/fabAdd"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_fab"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:paddingEnd="3dp"
        android:paddingBottom="4dp"
        app:layout_constraintBottom_toTopOf="@id/navBar"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="+"
            android:textColor="@color/graphite"
            android:textSize="32sp"
            android:textStyle="bold"
            android:includeFontPadding="false" />

    </FrameLayout>

    <!-- Bottom navigation bar -->
    <include
        android:id="@+id/navBar"
        layout="@layout/fragment_navbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Reused header include (yellow bar, title, hourglass icon) —
         drawn last so it renders above the search bar / filters / list,
         which now start from the top of the screen and scroll underneath it -->
    <include
        android:id="@+id/appHeader"
        layout="@layout/layout_app_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>