<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:background="@drawable/bg_dotted_paper">

    <!-- ===== Header: pinned at the very top ===== -->
    <include
        android:id="@+id/appHeader"
        layout="@layout/layout_app_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ===== List View / Calendar View toggle (static) ===== -->
    <LinearLayout
        android:id="@+id/toggleViewMode"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:layout_marginStart="60dp"
        android:layout_marginEnd="60dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_selector_myses"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:layout_constraintTop_toBottomOf="@id/appHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/toggleListView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"

            android:text="List View"
            android:textSize="12sp"
            android:textColor="@color/light_graphite"
            android:gravity="center"
            android:padding="8dp"
            android:includeFontPadding="false"
            android:fontFamily="@font/bricolagegrotesque_bold" />

        <TextView
            android:id="@+id/toggleCalendar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_segment_myses"
            android:text="Calendar View"
            android:textStyle="bold"
            android:textSize="12sp"
            android:textColor="@color/graphite"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:includeFontPadding="false"
            android:fontFamily="@font/bricolagegrotesque_bold" />

    </LinearLayout>

    <!-- ===== Month card: header (prev/next + month label) + weekday row + day grid (static) ===== -->
    <LinearLayout
        android:id="@+id/cardCalendar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingTop="4dp"
        android:paddingEnd="6dp"
        android:paddingBottom="10dp"
        android:background="@drawable/bg_whitebox_dropsd"
        app:layout_constraintTop_toBottomOf="@id/toggleViewMode"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Month header: prev arrow / month-year label / next arrow -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_header_clay"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <ImageButton
                android:id="@+id/btnPrevMonth"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_chevron_right"
                android:scaleX="-1"
                android:background="@android:color/transparent"
                android:contentDescription="Previous month"
                app:tint="@color/graphite"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/tvMonthYear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="October 2023"
                android:textStyle="bold"
                android:textSize="24sp"
                android:textColor="@color/graphite"
                android:fontFamily="@font/bricolagegrotesque_bold" />

            <ImageButton
                android:id="@+id/btnNextMonth"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_chevron_right"
                android:background="@android:color/transparent"
                android:contentDescription="Next month"
                app:tint="@color/graphite"
                tools:ignore="ContentDescription" />

        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="2.5dp"
            android:background="@color/graphite" />

        <!-- Weekday label row (static, never changes) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/white"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <TextView style="@style/CalendarWeekdayLabel" android:textColor="@color/graphite" android:text="M" />
            <TextView style="@style/CalendarWeekdayLabel" android:textColor="@color/graphite" android:text="T" />
            <TextView style="@style/CalendarWeekdayLabel" android:textColor="@color/graphite" android:text="W" />
            <TextView style="@style/CalendarWeekdayLabel" android:textColor="@color/graphite" android:text="T" />
            <TextView style="@style/CalendarWeekdayLabel" android:textColor="@color/graphite" android:text="F" />
            <TextView style="@style/CalendarWeekdayLabel" android:textColor="@color/graphite" android:text="S" />
            <TextView style="@style/CalendarWeekdayLabel" android:textColor="@color/graphite" android:text="S" />

        </LinearLayout>

        <!-- Day grid: 7-column RecyclerView, populated with real date data at runtime -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCalendarDays"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:paddingStart="16dp"
            android:paddingVertical="4dp"
            android:nestedScrollingEnabled="false"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:spanCount="7"
            tools:listitem="@layout/item_calendar_day"
            tools:itemCount="35" />

    </LinearLayout>

    <!-- ===== Sessions for the selected date ===== -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollSelectedDateSessions"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/rowSelectedDate"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/navBar">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSelectedDateSessions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            tools:listitem="@layout/item_session_calendar"
            tools:itemCount="2" />

    </androidx.core.widget.NestedScrollView>

    <!-- ===== Selected date divider (e.g. "Wednesday, Oct 11")  ===== -->
    <include
        android:id="@+id/rowSelectedDate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        layout="@layout/item_my_session_dateheader"
        android:layout_marginTop="20dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/cardCalendar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- ===== Bottom navigation bar ===== -->
    <include
        android:id="@+id/navBar"
        layout="@layout/fragment_navbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
