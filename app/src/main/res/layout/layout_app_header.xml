<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@drawable/bg_appheader">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/back_btn_container"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@android:color/white"
        app:cardPreventCornerOverlap="true"
        app:cardUseCompatPadding="false"
        app:strokeWidth="2dp"
        app:strokeColor="@color/graphite"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

    <ImageButton
        android:id="@+id/back_btn"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/ic_back"
        android:scaleType="fitCenter"
        android:padding="11.5dp"
        app:tint="@color/graphite"
        android:clickable="false"
        android:focusable="false"
        android:background="@android:color/transparent"/>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/user_avatar_container"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:cardCornerRadius="9999dp"
        app:cardElevation="0dp"
        app:strokeWidth="4dp"
        app:strokeColor="@color/graphite"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/user_avatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_profile"
            android:scaleType="fitCenter"
            android:padding="8dp"
            app:tint="@color/graphite"
            android:clickable="false"
            android:focusable="false"
            android:background="@android:color/white"
            android:backgroundTint="@android:color/white" />

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/screen_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="24sp"
        android:textStyle="bold"
        android:text="Home"
        android:textColor="@color/graphite"
        android:fontFamily="@font/bricolagegrotesque_bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/rightmost_btn_container"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeWidth="2dp"
        app:strokeColor="@color/graphite"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/rightmost_btn"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_hourglass"
            android:scaleType="fitCenter"
            android:padding="10dp"
            app:tint="@color/graphite"
            android:clickable="false"
            android:focusable="false"
            android:background="@android:color/white"
            android:backgroundTint="@android:color/white" />
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/right_btn_container"
        android:visibility="gone"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeWidth="2dp"
        app:strokeColor="@color/graphite"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/rightmost_btn_container"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginEnd="8dp">

        <ImageButton
            android:id="@+id/right_btn"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_upload"
            android:scaleType="fitCenter"
            android:padding="10dp"
            app:tint="@color/graphite"
            android:clickable="false"
            android:focusable="false"
            android:background="@android:color/white"
            android:backgroundTint="@android:color/white" />

    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>